{
  "manifest_version": 3,
  "name": "Oscilloscope Now Playing Bridge",
  "version": "1.0.0",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "*://open.spotify.com/*",
    "*://www.youtube.com/*",
    "*://music.youtube.com/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": ["content-osc.js"],
      "run_at": "document_idle"
    }
  ]
}
